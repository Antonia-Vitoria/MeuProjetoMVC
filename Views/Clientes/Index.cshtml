@model IEnumerable<LHPet.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="card card-custom p-4 mb-4">
    <div>
        <h2 class="page-heading mb-2">Clientes e pacientes</h2>
        <p class="mb-0">Aqui você encontra os clientes cadastrados e o nome do paciente associado a cada um.</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card client-card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Nome)</h5>
                        <p class="card-text mb-2">
                            <strong>CPF:</strong> @{
                                var cpf = item.Cpf;
                                var cpfMascarado = cpf.Length >= 5 ? cpf.Substring(0, 3) + "******" + cpf.Substring(cpf.Length - 2) : cpf;
                            }@cpfMascarado<br />
                            <strong>Email:</strong> @{
                                var email = item.Email;
                                var atIndex = email.IndexOf('@');
                                var emailMascarado = atIndex > 1 ? email.Substring(0, 1) + "***" + email.Substring(atIndex) : email;
                            }@emailMascarado<br />
                            <strong>Paciente:</strong> @Html.DisplayFor(modelItem => item.Paciente)
                        </p>
                        <div class="d-flex gap-2 mt-auto">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Encerrar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted">Nenhum cliente cadastrado ainda.</p>
        <a asp-action="Create" class="btn btn-primary">Cadastrar primeiro cliente</a>
    </div>
}
