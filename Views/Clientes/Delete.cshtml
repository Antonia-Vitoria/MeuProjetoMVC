@model LHPet.Models.Cliente

@{
    ViewData["Title"] = "Encerrar conta";
}

<div class="card card-custom p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="page-heading mb-1">Encerrar conta</h2>
            <p class="text-muted mb-0">Confirme os dados antes de prosseguir com a exclusão.</p>
        </div>
        <span class="badge badge-danger">Atenção</span>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="alert alert-warning" role="alert">
        <strong>Atenção:</strong> Esta ação não pode ser desfeita. Todos os dados do cliente e paciente serão removidos permanentemente.
    </div>

    <hr />

    <dl class="row">
        <dt class="col-sm-3 text-muted">Cliente</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-3 text-muted">CPF</dt>
        <dd class="col-sm-9 fw-semibold">@{
            var cpf = Model.Cpf;
            var cpfMascarado = cpf.Length >= 5 ? cpf.Substring(0, 3) + "******" + cpf.Substring(cpf.Length - 2) : cpf;
        }@cpfMascarado</dd>

        <dt class="col-sm-3 text-muted">Email</dt>
        <dd class="col-sm-9 fw-semibold">@{
            var email = Model.Email;
            var atIndex = email.IndexOf('@');
            var emailMascarado = atIndex > 1 ? email.Substring(0, 1) + "***" + email.Substring(atIndex) : email;
        }@emailMascarado</dd>

        <dt class="col-sm-3 text-muted">Paciente</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Paciente)</dd>
    </dl>

    <hr />

    <h5 class="mb-3">Confirmação de segurança</h5>
    <p class="text-muted mb-3">Para confirmar a exclusão, digite o nome completo e CPF do cliente:</p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label for="confirmacaoNome" class="form-label">Nome completo</label>
            <input type="text" class="form-control" id="confirmacaoNome" name="confirmacaoNome" required />
        </div>
        <div class="mb-3">
            <label for="confirmacaoCpf" class="form-label">CPF</label>
            <input type="text" class="form-control" id="confirmacaoCpf" name="confirmacaoCpf" required />
        </div>

        <div class="d-flex gap-2">
            <input type="submit" value="Encerrar conta" class="btn btn-danger px-4" />
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>
