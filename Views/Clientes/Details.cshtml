@model LHPet.Models.Cliente

@{
    ViewData["Title"] = "Detalhes";
}

<div class="card card-custom p-4 mb-4 patient-card">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="page-heading mb-1">Ficha do paciente</h2>
            <p class="text-muted mb-0">Visualize os dados do cliente e do pet em um formato claro e amigável.</p>
        </div>
        <span class="badge badge-soft">Veterinária</span>
    </div>

    <hr />

    <dl class="row">
        <dt class="col-sm-3 text-muted">Cliente</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-3 text-muted">CPF</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Cpf)</dd>

        <dt class="col-sm-3 text-muted">Email</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3 text-muted">Paciente</dt>
        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Paciente)</dd>
    </dl>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-secondary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
